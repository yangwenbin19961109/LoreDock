{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loredock.app/schemas/evaluation-cases-v1.json",
  "title": "LoreDock retrieval evaluation cases v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "query", "expected_sources"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "query": { "type": "string", "minLength": 1 },
      "expected_sources": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "expected_passages": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "tags": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    }
  }
}
