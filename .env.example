# LoreDock development environment
# Copy this file to .env for local development. Never commit real credentials.

LOREDOCK_ENV=development
LOREDOCK_HOST=127.0.0.1
LOREDOCK_PORT=49321
LOREDOCK_LOG_LEVEL=info

# Leave empty to use the platform-specific application data directory.
LOREDOCK_DATA_DIR=

# Local inference cache. Leave empty to use the LoreDock data directory.
LOREDOCK_MODEL_DIR=

# Optional external model providers. Configure only the provider being tested.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Remote MCP and server authentication are disabled by default in development.
LOREDOCK_AUTH_SECRET=
